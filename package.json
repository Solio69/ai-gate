{
  "name": "ai-gate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "vercel-build": "npm run build -w apps/api",
    "test:vercel-runtime": "npm run vercel-build && node scripts/check-vercel-runtime.mjs"
  }
}
